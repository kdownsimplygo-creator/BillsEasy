<Window x:Class="BillsEasy.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="{Binding Title}"
        Height="700" Width="1060"
        MinHeight="580" MinWidth="850"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Gesture="Alt+N" Command="{Binding CreateCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+O" Command="{Binding OpenCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+M" Command="{Binding EditActiveCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+F" Command="{Binding ManageFinancialYearsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+G" Command="{Binding ManageAccountGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+L" Command="{Binding ManageLedgersCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Company">
                <MenuItem Header="_Create Company..." Command="{Binding CreateCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+N" />
                <MenuItem Header="_Open / Select Company..." Command="{Binding OpenCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+O" />
                <MenuItem Header="_Modify Active Company..." Command="{Binding EditActiveCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" IsEnabled="{Binding HasActiveCompany}" InputGestureText="Alt+M" />
                <Separator />
                <MenuItem Header="_Manage Financial Years..." Command="{Binding ManageFinancialYearsCommand}" CommandParameter="{Binding ElementName=RootWindow}" IsEnabled="{Binding HasActiveCompany}" InputGestureText="Alt+F" />
                <Separator />
                <MenuItem Header="_Close Company" Command="{Binding CloseActiveCompanyCommand}" IsEnabled="{Binding HasActiveCompany}" />
            </MenuItem>
            <MenuItem Header="_Masters" IsEnabled="{Binding HasActiveCompany}">
                <MenuItem Header="_Account Groups..." Command="{Binding ManageAccountGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+G" />
                <MenuItem Header="Accounts / _Ledgers..." Command="{Binding ManageLedgersCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+L" />
            </MenuItem>
            <MenuItem Header="_Vouchers (Phase 1.5 Frozen)">
                <MenuItem Header="Payment Voucher (F5) [LOCKED]" IsEnabled="False" />
                <MenuItem Header="Receipt Voucher (F6) [LOCKED]" IsEnabled="False" />
                <MenuItem Header="Journal Voucher (F7) [LOCKED]" IsEnabled="False" />
                <MenuItem Header="Sales Invoice (F8) [LOCKED]" IsEnabled="False" />
                <MenuItem Header="Purchase Bill (F9) [LOCKED]" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Reports" IsEnabled="False">
                <MenuItem Header="Day Book [Phase 1.8]" IsEnabled="False" />
                <MenuItem Header="Trial Balance [Phase 1.8]" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About BillsEasy" />
            </MenuItem>
        </Menu>

        <!-- Executive Accounting Context Strip -->
        <Border Grid.Row="1" Background="{StaticResource ShellHeaderBackgroundBrush}" Padding="14,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="BillsEasy" FontWeight="Bold" FontSize="{StaticResource FontSizeMedium}" Foreground="#FFFFFF" />
                    <TextBlock Text=" | " Foreground="#64748B" Margin="6,0" />
                    <TextBlock Text="Active Company: " Foreground="#94A3B8" FontSize="{StaticResource FontSizeBody}" />
                    <TextBlock Text="{Binding ActiveCompanyText}" FontWeight="Bold" Foreground="#60A5FA" FontSize="{StaticResource FontSizeBody}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="FY: " Foreground="#94A3B8" FontSize="{StaticResource FontSizeBody}" />
                    <TextBlock Text="{Binding ActiveFinancialYearText}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="{StaticResource FontSizeBody}" Margin="0,0,16,0" />
                    <TextBlock Text="User: system_admin" Foreground="#CBD5E1" FontSize="{StaticResource FontSizeBody}" Margin="0,0,16,0" />
                    <Border Background="#1E3A8A" Padding="6,1" CornerRadius="1">
                        <TextBlock Text="DESKTOP ACCOUNTING" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Accounting Workstation Workspace -->
        <Grid Grid.Row="2" Margin="{StaticResource DialogPadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Accounting Gateway Navigation -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Gateway Header -->
                        <Border Background="{StaticResource GridHeaderBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,0,10">
                            <TextBlock Text="GATEWAY OF BILLSEASY" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Center" />
                        </Border>

                        <!-- Company Section -->
                        <controls:AccountingSection Title="COMPANY OPERATIONS" />
                        <StackPanel Margin="0,0,0,10">
                            <Button Content="_Open / Select Company (Alt+O)"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    Command="{Binding OpenCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                            <Button Content="_Create New Company (Alt+N)"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    Command="{Binding CreateCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                            <Button Content="_Modify Active Company (Alt+M)"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    IsEnabled="{Binding HasActiveCompany}"
                                    Command="{Binding EditActiveCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                            <Button Content="Manage _Financial Years (Alt+F)"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    IsEnabled="{Binding HasActiveCompany}"
                                    Command="{Binding ManageFinancialYearsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                            <Button Content="Close Active Company"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    IsEnabled="{Binding HasActiveCompany}"
                                    Command="{Binding CloseActiveCompanyCommand}" />
                        </StackPanel>

                        <!-- Masters Section -->
                        <controls:AccountingSection Title="CHART OF ACCOUNTS &amp; MASTERS" />
                        <StackPanel Margin="0,0,0,10" IsEnabled="{Binding HasActiveCompany}">
                            <Button Content="Account _Groups Master (Alt+G)"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    Command="{Binding ManageAccountGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                            <Button Content="Accounts / _Ledgers Master (Alt+L)"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    Command="{Binding ManageLedgersCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                        </StackPanel>

                        <!-- Vouchers & Transactions (Phase 1.5 Frozen) -->
                        <controls:AccountingSection Title="VOUCHER OPERATIONS (PHASE 1.5 — FROZEN)" />
                        <StackPanel Margin="0,0,0,4">
                            <Button Content="Payment Voucher (F5)  🔒"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    IsEnabled="False" />
                            <Button Content="Receipt Voucher (F6)  🔒"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    IsEnabled="False" />
                            <Button Content="Sales Invoice (F8)  🔒"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    IsEnabled="False" />
                            <Button Content="Purchase Bill (F9)  🔒"
                                    HorizontalContentAlignment="Left" Padding="10,2" Margin="0,0,0,4"
                                    IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Active Company Workstation or No-Company Prompt -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="16">
                <Grid>
                    <!-- View A: Company Active Workstation -->
                    <Grid Visibility="{Binding HasActiveCompany, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Active Company Header Banner -->
                        <Border Grid.Row="0" Background="{StaticResource GridHeaderBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding ActiveCompanyText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                    <TextBlock Text="{Binding ActiveFinancialYearText, StringFormat='Financial Year: {0}'}" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource SuccessBackgroundBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="● BOOKS ACTIVE" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource SuccessBrush}" />
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Workstation Operations Strip -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <controls:AccountingSection Title="WORKSTATION MASTER SHORTCUTS" />
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Accounts / Ledgers Master (Alt+L)" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                        <TextBlock Text="Manage customers, vendors, bank accounts, and statutory tax ledgers." Style="{StaticResource HelperTextStyle}" Margin="0,3,0,10" />
                                        <Button Content="Open Ledgers Directory (Alt+L)" Style="{StaticResource PrimaryButtonStyle}" Height="{StaticResource ButtonHeightDense}"
                                                Command="{Binding ManageLedgersCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Chart of Accounts &amp; Groups (Alt+G)" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                        <TextBlock Text="Manage 5-nature hierarchical chart of accounts and sub-groups." Style="{StaticResource HelperTextStyle}" Margin="0,3,0,10" />
                                        <Button Content="Open Account Groups (Alt+G)" Height="{StaticResource ButtonHeightDense}"
                                                Command="{Binding ManageAccountGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- System Integrity Details -->
                        <StackPanel Grid.Row="2">
                            <controls:AccountingSection Title="SYSTEM INTEGRITY &amp; ARCHITECTURE" />
                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Architecture: Clean Architecture (.NET 8 WPF)" Style="{StaticResource HelperTextStyle}" Margin="0,0,0,4" />
                                        <TextBlock Text="Monetary Model: Exact Integer Minor Units (Paise)" Style="{StaticResource HelperTextStyle}" Margin="0,0,0,4" />
                                        <TextBlock Text="Security: User Authentication &amp; Audit Trail Enabled" Style="{StaticResource HelperTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Database: Microsoft.Data.Sqlite (Raw Parameterized ADO.NET)" Style="{StaticResource HelperTextStyle}" Margin="0,0,0,4" />
                                        <TextBlock Text="Validation: Domain-Enforced Check Constraints" Style="{StaticResource HelperTextStyle}" Margin="0,0,0,4" />
                                        <TextBlock Text="Engine Status: Phase 1.1–1.4.5 Certified (124/124 Tests Passing)" Style="{StaticResource HelperTextStyle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- View B: No Company Active Workspace Callout -->
                    <Grid Visibility="{Binding HasActiveCompany, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                            <Border Background="{StaticResource GridHeaderBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="BILLSEASY ACCOUNTING WORKSTATION" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No active company is currently loaded. Open an existing company or create a new business profile to start accounting operations."
                                               Style="{StaticResource HelperTextStyle}" TextAlignment="Center" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Button Content="_Open Company (Alt+O)" Style="{StaticResource PrimaryButtonStyle}" Width="200" Height="30" Margin="0,0,12,0"
                                        Command="{Binding OpenCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                                <Button Content="_Create Company (Alt+N)" Width="200" Height="30"
                                        Command="{Binding CreateCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Function Key Shortcut Bar -->
        <Border Grid.Row="3" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[Alt+O] Open Co" Style="{StaticResource ShortcutLegendStyle}" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Text="[Alt+N] New Co" Style="{StaticResource ShortcutLegendStyle}" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Text="[Alt+L] Ledgers" Style="{StaticResource ShortcutLegendStyle}" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Text="[Alt+G] Groups" Style="{StaticResource ShortcutLegendStyle}" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Text="[Alt+F] FY" Style="{StaticResource ShortcutLegendStyle}" FontWeight="SemiBold" Margin="0,0,14,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" Style="{StaticResource HelperTextStyle}" FontWeight="Medium" Foreground="{StaticResource PrimaryBrandBrush}" />
            </DockPanel>
        </Border>

        <!-- Bottom System Status Bar -->
        <controls:AccountingStatusBar Grid.Row="4"
                                      StatusMessage="{Binding StatusMessage}"
                                      ActiveCompany="{Binding ActiveCompanyText}"
                                      ActiveFinancialYear="{Binding ActiveFinancialYearText}"
                                      CurrentUser="system_admin"
                                      VersionTag="BillsEasy 1.4.5" />
    </Grid>
</Window>