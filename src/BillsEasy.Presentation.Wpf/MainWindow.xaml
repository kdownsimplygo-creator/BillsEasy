<Window x:Class="BillsEasy.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="{Binding Title}"
        Height="850" Width="1320"
        MinHeight="680" MinWidth="1100"
        Background="#F1F5F9"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Gesture="Alt+N" Command="{Binding CreateCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+O" Command="{Binding OpenCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+M" Command="{Binding EditActiveCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+F" Command="{Binding ManageFinancialYearsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+G" Command="{Binding ManageAccountGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+L" Command="{Binding ManageLedgersCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+U" Command="{Binding ManageUnitsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+I" Command="{Binding ManageItemGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+P" Command="{Binding ManageItemsCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Alt+R" Command="{Binding RefreshDashboardCommand}" />
        <KeyBinding Key="F9" Command="{Binding OpenPurchaseInvoiceCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
        <KeyBinding Gesture="Shift+F9" Command="{Binding OpenPurchaseListCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Menu Bar -->
        <Border Grid.Row="0" Background="{StaticResource ModernNavyHeaderBrush}" BorderThickness="0">
            <Menu Background="Transparent" Foreground="#E2E8F0" Height="26">
                <MenuItem Header="_Company" Foreground="#E2E8F0">
                    <MenuItem Header="_Create Company..." Command="{Binding CreateCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+N" Foreground="{StaticResource TextPrimaryBrush}" />
                    <MenuItem Header="_Open / Select Company..." Command="{Binding OpenCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+O" Foreground="{StaticResource TextPrimaryBrush}" />
                    <MenuItem Header="_Modify Active Company..." Command="{Binding EditActiveCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" IsEnabled="{Binding HasActiveCompany}" InputGestureText="Alt+M" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Separator />
                    <MenuItem Header="_Manage Financial Years..." Command="{Binding ManageFinancialYearsCommand}" CommandParameter="{Binding ElementName=RootWindow}" IsEnabled="{Binding HasActiveCompany}" InputGestureText="Alt+F" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Separator />
                    <MenuItem Header="_Close Company" Command="{Binding CloseActiveCompanyCommand}" IsEnabled="{Binding HasActiveCompany}" Foreground="{StaticResource ErrorBrush}" />
                </MenuItem>
                <MenuItem Header="_Masters" IsEnabled="{Binding HasActiveCompany}" Foreground="#E2E8F0">
                    <MenuItem Header="_Account Groups..." Command="{Binding ManageAccountGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+G" Foreground="{StaticResource TextPrimaryBrush}" />
                    <MenuItem Header="Accounts / _Ledgers..." Command="{Binding ManageLedgersCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+L" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Separator />
                    <MenuItem Header="_Units of Measurement..." Command="{Binding ManageUnitsCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+U" Foreground="{StaticResource TextPrimaryBrush}" />
                    <MenuItem Header="Item _Groups..." Command="{Binding ManageItemGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+I" Foreground="{StaticResource TextPrimaryBrush}" />
                    <MenuItem Header="_Items (Stock Products)..." Command="{Binding ManageItemsCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Alt+P" Foreground="{StaticResource TextPrimaryBrush}" />
                </MenuItem>
                <MenuItem Header="_Transactions" IsEnabled="{Binding HasActiveCompany}" Foreground="#E2E8F0">
                    <MenuItem Header="_Purchase Invoice..." Command="{Binding OpenPurchaseInvoiceCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="F9" Foreground="{StaticResource TextPrimaryBrush}" />
                    <MenuItem Header="Purchase _List / Register..." Command="{Binding OpenPurchaseListCommand}" CommandParameter="{Binding ElementName=RootWindow}" InputGestureText="Shift+F9" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Separator />
                    <MenuItem Header="Payment Voucher (F5) [Phase 2]" IsEnabled="False" Foreground="{StaticResource TextDisabledBrush}" />
                    <MenuItem Header="Receipt Voucher (F6) [Phase 2]" IsEnabled="False" Foreground="{StaticResource TextDisabledBrush}" />
                    <MenuItem Header="Journal Voucher (F7) [Phase 2]" IsEnabled="False" Foreground="{StaticResource TextDisabledBrush}" />
                    <MenuItem Header="Sales Invoice (F8) [Phase 2]" IsEnabled="False" Foreground="{StaticResource TextDisabledBrush}" />
                </MenuItem>
                <MenuItem Header="_Reports" IsEnabled="False" Foreground="#94A3B8">
                    <MenuItem Header="Day Book [Phase 2]" IsEnabled="False" />
                    <MenuItem Header="Trial Balance [Phase 2]" IsEnabled="False" />
                    <MenuItem Header="Stock Summary [Phase 2]" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="_Help" Foreground="#E2E8F0">
                    <MenuItem Header="About BillsEasy" Foreground="{StaticResource TextPrimaryBrush}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- Top Application Enterprise Header (Navy Bar Matching Reference Design) -->
        <Border Grid.Row="1" Background="{StaticResource ModernNavyHeaderBrush}" BorderBrush="#1E3A5F" BorderThickness="0,0,0,1" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!-- Left: Application Brand Identity -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="BillsEasy" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Desktop Accounting" FontSize="13" Foreground="#94A3B8" Margin="8,4,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Dedicated Active Company Card Pill -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#13355C" BorderBrush="#1E4B82" BorderThickness="1" CornerRadius="8" Padding="14,6">
                    <DockPanel LastChildFill="True">
                        <Border Width="32" Height="32" CornerRadius="6" Background="#1E4B82" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBuilding}" Fill="#93C5FD" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveCompanyText}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding ActiveCompanyStateText}" FontSize="11" Foreground="#93C5FD" />
                                <TextBlock Text="  |  " FontSize="11" Foreground="#64748B" Visibility="{Binding HasActiveCompany, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="● Books Active" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" Visibility="{Binding HasActiveCompany, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Select or Create a Company to begin" FontSize="11" Foreground="#94A3B8" Visibility="{Binding HasActiveCompany, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Right: Financial Year & User Profile Identity -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- FY Block -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Path Data="{StaticResource IconCalendar}" Fill="#93C5FD" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Financial Year" FontSize="10" Foreground="#94A3B8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ActiveFinancialYearText}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                <Path Data="{StaticResource IconChevronDown}" Fill="#93C5FD" Width="10" Height="10" Stretch="Uniform" Margin="4,3,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveCompanyBooksBeginningText, StringFormat='Books From: {0}'}" FontSize="10" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <!-- User Profile Block -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#1E4B82" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconUser}" Fill="#93C5FD" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="system_admin" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Administrator" FontSize="10" Foreground="#94A3B8" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Accounting Workstation Workspace -->
        <Grid Grid.Row="2" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Accounting Gateway Navigation -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Active Dashboard Pill -->
                        <Border Background="{StaticResource ModernLightBlueBrush}" BorderBrush="{StaticResource ModernPrimaryBlueBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDashboard}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="Dashboard" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource ModernPrimaryBlueBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Company Operations -->
                        <TextBlock Text="COMPANY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="6,4,0,6" />
                        <StackPanel Margin="0,0,0,10">
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding OpenCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+O" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconFolder}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="_Open / Select Company" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding CreateCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+N" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconPlusCircle}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="_Create New Company" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="{Binding HasActiveCompany}" Command="{Binding EditActiveCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+M" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconEdit}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="_Modify Active Company" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="{Binding HasActiveCompany}" Command="{Binding ManageFinancialYearsCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+F" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconCalendar}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Manage _Financial Years" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="{Binding HasActiveCompany}" Command="{Binding CloseActiveCompanyCommand}">
                                <DockPanel LastChildFill="True">
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconCloseCircle}" Fill="{StaticResource ErrorBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Close Active Company" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                        </StackPanel>

                        <!-- Masters Section -->
                        <TextBlock Text="MASTERS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="6,4,0,6" />
                        <StackPanel Margin="0,0,0,10" IsEnabled="{Binding HasActiveCompany}">
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ManageAccountGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+G" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconHierarchy}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Account _Groups" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ManageLedgersCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+L" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconUsers}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Accounts / _Ledgers" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ManageUnitsCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+U" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconRuler}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="_Units of Measurement" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ManageItemGroupsCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+I" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconFolder}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Item _Groups" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ManageItemsCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Alt+P" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconBox}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="_Items (Stock Catalog)" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                        </StackPanel>

                        <!-- Transactions Section -->
                        <TextBlock Text="TRANSACTIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="6,4,0,6" />
                        <StackPanel Margin="0,0,0,10" IsEnabled="{Binding HasActiveCompany}">
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding OpenPurchaseInvoiceCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource ModernLightBlueBrush}" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="F9" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ModernPrimaryBlueBrush}" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconCart}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="_Purchase Bill" FontWeight="SemiBold" Foreground="{StaticResource ModernPrimaryBlueBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding OpenPurchaseListCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Shift+F9" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                    </Border>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconInvoiceSearch}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Purchase _Register" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False" ToolTip="Backend accounting logic validated (Class 4). Dedicated entry UI scheduled for Phase 2.">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="(Phase 2)" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconRupee}" Fill="{StaticResource TextDisabledBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Payment Voucher  F5" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False" ToolTip="Backend accounting logic validated (Class 5). Dedicated entry UI scheduled for Phase 2.">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="(Phase 2)" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconReceipt}" Fill="{StaticResource TextDisabledBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Receipt Voucher  F6" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False" ToolTip="Backend accounting logic validated (Class 6). Dedicated entry UI scheduled for Phase 2.">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="(Phase 2)" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconJournal}" Fill="{StaticResource TextDisabledBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Journal Voucher  F7" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False" ToolTip="Sales Invoice voucher engine scheduled for subsequent implementation class.">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="(Phase 2)" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconInvoicePlus}" Fill="{StaticResource TextDisabledBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Sales Invoice  F8" Foreground="{StaticResource TextDisabledBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                        </StackPanel>

                        <!-- Reports Section -->
                        <TextBlock Text="REPORTS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="6,4,0,6" />
                        <StackPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="(Phase 2)" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Day Book" Foreground="{StaticResource TextDisabledBrush}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="(Phase 2)" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Trial Balance" Foreground="{StaticResource TextDisabledBrush}" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" IsEnabled="False">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="(Phase 2)" FontSize="10" Foreground="{StaticResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Stock Summary" Foreground="{StaticResource TextDisabledBrush}" />
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Active Company Workstation or No-Company Prompt -->
            <Grid Grid.Column="2">
                <!-- View A: Company Active Workstation -->
                <ScrollViewer Visibility="{Binding HasActiveCompany, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Dashboard Title Bar -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding RefreshDashboardCommand}"
                                    Style="{StaticResource NavButtonStyle}"
                                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Padding="12,5" Height="32" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRefresh}" Fill="#334155" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh (Alt+R)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDashboard}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dashboard" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ModernTextPrimaryBrush}" />
