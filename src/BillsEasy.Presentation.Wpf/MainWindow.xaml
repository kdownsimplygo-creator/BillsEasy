                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{StaticResource SoftBadgeGreenBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
