                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 2: Bank Accounts -->
                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{StaticResource SoftBadgeBlueBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconBuilding}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="BANK ACCOUNTS" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <DockPanel Margin="0,3,0,1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding BankBalanceType}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ModernSuccessGreenBrush}" VerticalAlignment="Bottom" Margin="6,0,0,2" />
                                            <TextBlock Text="{Binding BankBalance, Converter={StaticResource IndianCurrency}}" FontSize="17" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="{StaticResource ModernTextPrimaryBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="Reconciled Bank Funds" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 3: Receivables (Debtors) -->
                            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{StaticResource SoftBadgeOrangeBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconUsers}" Fill="{StaticResource SoftBadgeOrangeIconBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="RECEIVABLES (DEBTORS)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <DockPanel Margin="0,3,0,1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ReceivablesBalanceType}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ModernSuccessGreenBrush}" VerticalAlignment="Bottom" Margin="6,0,0,2" />
                                            <TextBlock Text="{Binding ReceivablesBalance, Converter={StaticResource IndianCurrency}}" FontSize="17" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="{StaticResource ModernTextPrimaryBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="Outstanding Customer Dues" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 4: Payables (Creditors) -->
                            <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{StaticResource SoftBadgeRedBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconTruck}" Fill="{StaticResource ModernDangerRedBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="PAYABLES (CREDITORS)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <DockPanel Margin="0,3,0,1">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PayablesBalanceType}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ModernDangerRedBrush}" VerticalAlignment="Bottom" Margin="6,0,0,2" />
                                            <TextBlock Text="{Binding PayablesBalance, Converter={StaticResource IndianCurrency}}" FontSize="17" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono, Courier New" Foreground="{StaticResource ModernTextPrimaryBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="Supplier Invoices Outstanding" FontSize="11" Foreground="#94A3B8" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Quick Operations Action-Card Toolbar (Row 2) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconLightning}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Quick Operations" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ModernTextPrimaryBrush}" />
                                        <TextBlock Text="Frequently used transactions and master data" FontSize="11" Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. New Purchase Bill (Primary Card) -->
                                    <Button Grid.Column="0" Style="{StaticResource PrimaryActionCardButtonStyle}"
                                            Command="{Binding OpenPurchaseInvoiceCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="{StaticResource IconInvoicePlus}" Fill="#FFFFFF" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Text="New Purchase Bill" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                                            <Border Grid.Row="2" Background="#1D4ED8" CornerRadius="4" Padding="12,2" HorizontalAlignment="Center">
                                                <TextBlock Text="F9" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- 2. Purchase Register (Secondary Card) -->
                                    <Button Grid.Column="2" Style="{StaticResource ActionCardButtonStyle}" BorderBrush="#BFDBFE"
                                            Command="{Binding OpenPurchaseListCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="{StaticResource IconInvoiceSearch}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Text="Purchase Register" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ModernTextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                                            <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,2" HorizontalAlignment="Center">
                                                <TextBlock Text="Shift + F9" FontWeight="Bold" FontSize="10" Foreground="{StaticResource ModernPrimaryBlueBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- 3. Payment Voucher (Phase 2) -->
                                    <Button Grid.Column="4" Style="{StaticResource DisabledActionCardButtonStyle}" ToolTip="Backend accounting logic validated (Class 4). Dedicated UI scheduled for Phase 2.">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="{StaticResource IconRupee}" Fill="#94A3B8" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="1" Text="Payment Voucher" FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" />
                                            <TextBlock Grid.Row="2" Text="F5" FontSize="10" Foreground="#94A3B8" TextAlignment="Center" Margin="0,2,0,4" />
                                            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                                                <TextBlock Text="Backend Validated" FontSize="9" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,2" />
                                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Center">
                                                    <TextBlock Text="UI Phase 2" FontSize="9" Foreground="#94A3B8" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- 4. Receipt Voucher (Phase 2) -->
                                    <Button Grid.Column="6" Style="{StaticResource DisabledActionCardButtonStyle}" ToolTip="Backend accounting logic validated (Class 5). Dedicated UI scheduled for Phase 2.">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="{StaticResource IconReceipt}" Fill="#94A3B8" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="1" Text="Receipt Voucher" FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" />
                                            <TextBlock Grid.Row="2" Text="F6" FontSize="10" Foreground="#94A3B8" TextAlignment="Center" Margin="0,2,0,4" />
                                            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                                                <TextBlock Text="Backend Validated" FontSize="9" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,2" />
                                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Center">
                                                    <TextBlock Text="UI Phase 2" FontSize="9" Foreground="#94A3B8" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- 5. Journal Voucher (Phase 2) -->
                                    <Button Grid.Column="8" Style="{StaticResource DisabledActionCardButtonStyle}" ToolTip="Backend accounting logic validated (Class 6). Dedicated UI scheduled for Phase 2.">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="{StaticResource IconJournal}" Fill="#94A3B8" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="1" Text="Journal Voucher" FontWeight="SemiBold" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" />
                                            <TextBlock Grid.Row="2" Text="F7" FontSize="10" Foreground="#94A3B8" TextAlignment="Center" Margin="0,2,0,4" />
                                            <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                                                <TextBlock Text="Backend Validated" FontSize="9" Foreground="#94A3B8" TextAlignment="Center" Margin="0,0,0,2" />
                                                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="6,1" HorizontalAlignment="Center">
                                                    <TextBlock Text="UI Phase 2" FontSize="9" Foreground="#94A3B8" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- 6. Stock Items (Active Master Card) -->
                                    <Button Grid.Column="10" Style="{StaticResource ActionCardButtonStyle}" BorderBrush="#A7F3D0"
                                            Command="{Binding ManageItemsCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="{StaticResource IconBox}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Text="Stock Items" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ModernTextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                                            <Border Grid.Row="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="10,2" HorizontalAlignment="Center">
                                                <TextBlock Text="Alt + P" FontWeight="Bold" FontSize="10" Foreground="{StaticResource ModernSuccessGreenBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- 7. Ledgers Master (Active Master Card) -->
                                    <Button Grid.Column="12" Style="{StaticResource ActionCardButtonStyle}" BorderBrush="#DDD6FE"
                                            Command="{Binding ManageLedgersCommand}" CommandParameter="{Binding ElementName=RootWindow}">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Path Grid.Row="0" Data="{StaticResource IconUsers}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Text="Ledgers Master" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ModernTextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                                            <Border Grid.Row="2" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4" Padding="10,2" HorizontalAlignment="Center">
                                                <TextBlock Text="Alt + L" FontWeight="Bold" FontSize="10" Foreground="{StaticResource ModernPurpleBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Inventory Snapshot (Row 3) -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding ManageItemsCommand}" CommandParameter="{Binding ElementName=RootWindow}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="View All Items (Alt+P)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ModernPrimaryBlueBrush}" />
                                            <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="10" Height="10" Stretch="Uniform" Margin="4,2,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconBox}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Inventory Snapshot (Live Physical Closing Stock)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ModernTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding InventorySnapshot}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="180"
                                          BorderBrush="#E2E8F0" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ITEM NAME" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="ITEM CODE / SKU" Binding="{Binding Code}" Width="*" Foreground="{StaticResource ModernTextSecondaryBrush}" />
                                        <DataGridTemplateColumn Header="CLOSING STOCK QTY" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Quantity, StringFormat='{}{0:#,##0.##}'}"
                                                               FontFamily="Consolas, Cascadia Mono, Courier New"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"
                                                               Foreground="{StaticResource ModernTextPrimaryBrush}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="UNIT" Binding="{Binding UnitName}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="STATUS" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#DCFCE7"
                                                            BorderBrush="#86EFAC"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="● " FontSize="8" Foreground="#15803D" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="#15803D" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- System Integrity & Database Validation (Row 4) -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card A: System Integrity -->
                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Path Data="{StaticResource IconGear}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="System Integrity &amp; Architecture" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ModernTextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Architecture: Clean Architecture (.NET 8 WPF)  |  Monetary Model: Exact Integer Minor Units (Paise) — No Float Drift" FontSize="11" Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,2" TextWrapping="Wrap" />
                                    <TextBlock Text="Security: User Authentication &amp; Audit Trail Enabled" FontSize="11" Foreground="{StaticResource ModernTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Card B: Database & Validation -->
                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Path Data="{StaticResource IconDatabase}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Database &amp; Validation" FontWeight="Bold" FontSize="13" Foreground="{StaticResource ModernTextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Database: Microsoft.Data.Sqlite (Raw Parameterized ADO.NET)" FontSize="11" Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="Validation: Domain-Enforced Check Constraints &amp; Bill-Wise Allocation" FontSize="11" Foreground="{StaticResource ModernTextSecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="Engine Status: Classes 1–8 Certified (381/381 Tests Passing)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource ModernSuccessGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- View B: No Company Active Workspace Callout -->
                <Grid Visibility="{Binding HasActiveCompany, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24,20" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SoftBadgeBlueBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Path Data="{StaticResource IconBuilding}" Fill="{StaticResource ModernPrimaryBlueBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="BILLSEASY ACCOUNTING WORKSTATION" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ModernTextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No active company is currently loaded. Open an existing company or create a new business profile to start accounting operations."
                                           FontSize="12" Foreground="{StaticResource ModernTextSecondaryBrush}" TextAlignment="Center" Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Button Content="_Open Company (Alt+O)" Style="{StaticResource PrimaryButtonStyle}" Width="200" Height="34" Margin="0,0,12,0"
                                    Command="{Binding OpenCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                            <Button Content="_Create Company (Alt+N)" Width="200" Height="34"
                                    Command="{Binding CreateCompanyCommand}" CommandParameter="{Binding ElementName=RootWindow}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Function Key Shortcut Bar (Row 3) -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Active: " FontSize="11" Foreground="#64748B" />
                    <TextBlock Text="{Binding ActiveCompanyText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ModernPrimaryBlueBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="FY: " FontSize="11" Foreground="#64748B" />
