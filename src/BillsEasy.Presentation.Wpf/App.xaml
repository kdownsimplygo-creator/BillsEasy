<Application x:Class="BillsEasy.Presentation.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BillsEasy.Presentation.Wpf"
             xmlns:converters="clr-namespace:BillsEasy.Presentation.Wpf.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Colors.xaml" />
                <ResourceDictionary Source="/Themes/Typography.xaml" />
                <ResourceDictionary Source="/Themes/Spacing.xaml" />
                <ResourceDictionary Source="/Themes/ButtonStyles.xaml" />
                <ResourceDictionary Source="/Themes/InputStyles.xaml" />
                <ResourceDictionary Source="/Themes/DataGridStyles.xaml" />
                <ResourceDictionary Source="/Themes/TabControlStyles.xaml" />
                <ResourceDictionary Source="/Themes/DialogStyles.xaml" />
                <ResourceDictionary Source="/Themes/MenuStyles.xaml" />
                <ResourceDictionary Source="/Themes/StatusBarStyles.xaml" />
                <ResourceDictionary Source="/Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:IndianCurrencyConverter x:Key="IndianCurrency" />
            <converters:MoneyToStringConverter x:Key="MoneyToStringConverter" />
            <converters:SystemBadgeTextConverter x:Key="SystemBadgeText" />
            <converters:SystemBadgeBackgroundConverter x:Key="SystemBadgeBg" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
