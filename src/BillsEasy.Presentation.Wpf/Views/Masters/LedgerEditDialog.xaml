<Window x:Class="BillsEasy.Presentation.Wpf.Views.Masters.LedgerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="{Binding DialogTitle}"
        Height="540" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        behaviors:KeyboardNavigationBehavior.IsAutoAdvanceEnabled="True"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=LedgerNameTextBox}">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="{Binding DialogTitle}"
                                         Subtitle="Configure general ledger accounts, customer/supplier party profiles, statutory tax, and banking."
                                         EntityBadge="[Ledger Master]" />

        <!-- Tabbed Master Form Body -->
        <TabControl Grid.Row="1" Margin="0,0,0,6">
            <!-- TAB 1: BASIC & GROUP -->
            <TabItem Header="_1. Basic &amp; Group">
                <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Account Identification -->
                            <controls:AccountingSection Title="ACCOUNT IDENTIFICATION" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ledger / Party Name *" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="LedgerNameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Print Name (On Invoices)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PrintName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Alias / Short Code" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="{StaticResource FieldMarginDense}" />
                            </Grid>

                            <!-- Group Classification -->
                            <controls:AccountingSection Title="ACCOUNT GROUP CLASSIFICATION" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Under Account Group *" Style="{StaticResource FormLabelStyle}" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding GroupOptions}"
                                          SelectedItem="{Binding SelectedGroup}"
                                          DisplayMemberPath="Name" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SelectedGroup.GroupNature, StringFormat='Classification Nature: {0}'}"
                                           Style="{StaticResource HelperTextStyle}" Margin="0,2,0,0" />
                            </Grid>

                            <!-- System Ledger Notice -->
                            <Border Visibility="{Binding IsDefaultSystemLedger, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource InfoBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="8,4" Margin="0,6,0,0">
                                <TextBlock Text="ℹ Predefined System Ledger (Core Account)." Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource PrimaryBrandBrush}" FontWeight="Medium" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 2: OPENING BALANCE & BILL-WISE -->
            <TabItem Header="_2. Opening &amp; Credit">
                <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Opening Balance -->
                            <controls:AccountingSection Title="INITIAL OPENING BALANCE" />
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Opening Amount (₹)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Dr / Cr" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                                <ComboBox Grid.Row="0" Grid.Column="4"
                                          ItemsSource="{Binding OpeningBalanceTypeOptions}"
                                          SelectedItem="{Binding SelectedOpeningBalanceType}" />
                            </Grid>

                            <!-- Bill-Wise Details -->
                            <controls:AccountingSection Title="BILL-WISE &amp; CREDIT MANAGEMENT (TRADING PARTIES)" />
                            <CheckBox Content="Maintain Bill-by-Bill Balances (Bill-wise Accounting)"
                                      IsChecked="{Binding BillWiseEnabled}"
                                      FontWeight="SemiBold" Margin="0,2,0,8" />

                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Credit Period (Days)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CreditPeriodDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Credit Limit (₹)" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 3: STATUTORY & ADDRESS -->
            <TabItem Header="_3. Statutory &amp; Address">
                <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- GST & Statutory -->
                            <controls:AccountingSection Title="GST &amp; TAX IDENTIFICATION" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="GSTIN (15 Digits)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Registration Type" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                                <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding GstTypes}" SelectedItem="{Binding SelectedGstType}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="PAN (10 Digits)" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Pan, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Aadhaar / UID" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding AadhaarNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="{StaticResource FieldMarginDense}" />
                            </Grid>

                            <!-- Address -->
                            <controls:AccountingSection Title="POSTAL ADDRESS &amp; JURISDICTION" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Address Line 1" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Address Line 2" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="City / State / PIN" Style="{StaticResource FormLabelStyle}" />
                                <Grid Grid.Row="2" Grid.Column="1" Margin="{StaticResource FieldMarginDense}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" DisplayMemberPath="StateName" />
                                    <TextBox Grid.Column="4" Text="{Binding PinCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 4: CONTACT & BANKING -->
            <TabItem Header="_4. Contact &amp; Banking">
                <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Contact Details -->
                            <controls:AccountingSection Title="PARTY CONTACT INFORMATION" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Contact Person" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Email Address" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mobile Number" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MobileNumber, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="WhatsApp No." Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding WhatsAppNumber, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />
                            </Grid>

                            <!-- Bank Settlement Details -->
                            <controls:AccountingSection Title="BANK SETTLEMENT ACCOUNT" />
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Bank Name" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Account Number" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="IFSC Code" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BankIFSC, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" Margin="{StaticResource FieldMarginDense}" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Branch Name" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding BankBranch, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Standard Accounting Footer -->
        <controls:AccountingDialogFooter Grid.Row="2"
                                         ErrorMessage="{Binding ErrorMessage}"
                                         SaveCommand="{Binding SaveCommand}"
                                         SaveButtonText="_Save Ledger (F2)"
                                         CancelClicked="Cancel_Click" />
    </Grid>
</Window>