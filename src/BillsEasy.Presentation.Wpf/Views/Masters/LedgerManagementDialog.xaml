<Window x:Class="BillsEasy.Presentation.Wpf.Views.Masters.LedgerManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="Accounts &amp; Ledgers Master — Chart of Accounts"
        Height="620" Width="1020"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=LedgersDataGrid}"
        x:Name="ManagementWindow">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadLedgersCommand}" />
        <KeyBinding Gesture="Alt+A" Command="{Binding AddLedgerCommand}" CommandParameter="{Binding ElementName=ManagementWindow}" />
        <KeyBinding Gesture="Alt+M" Command="{Binding ModifyLedgerCommand}" CommandParameter="{Binding ElementName=ManagementWindow}" />
        <KeyBinding Gesture="Alt+D" Command="{Binding DeleteLedgerCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header with Group Filter & Search -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="Accounts &amp; Ledgers Master"
                                         Subtitle="{Binding ActiveCompanyName, StringFormat='Active Company: {0}'}"
                                         EntityBadge="[General Ledger]">
            <controls:AccountingDialogHeader.HeaderRightContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Group:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding GroupFilterOptions}"
                              SelectedItem="{Binding SelectedGroupFilter}"
                              DisplayMemberPath="Name"
                              Width="170" Height="{StaticResource ControlHeightDense}" Margin="0,0,12,0" />

                    <TextBlock Text="Search:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="170" Height="{StaticResource ControlHeightDense}" />
                </StackPanel>
            </controls:AccountingDialogHeader.HeaderRightContent>
        </controls:AccountingDialogHeader>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="6,3" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="_Add Ledger (Alt+A)" Style="{StaticResource PrimaryButtonStyle}" Height="{StaticResource ButtonHeightDense}" Padding="10,0" Margin="0,0,4,0"
                            Command="{Binding AddLedgerCommand}" CommandParameter="{Binding ElementName=ManagementWindow}" />
                    <Button Content="_Modify (Alt+M)" Height="{StaticResource ButtonHeightDense}" Padding="10,0" Margin="0,0,4,0"
                            Command="{Binding ModifyLedgerCommand}" CommandParameter="{Binding ElementName=ManagementWindow}"
                            IsEnabled="{Binding SelectedLedger, Converter={StaticResource NullToVis}}" />
                    <Button Content="_Delete (Alt+D)" Style="{StaticResource DangerButtonStyle}" Height="{StaticResource ButtonHeightDense}" Padding="10,0" Margin="0,0,4,0"
                            Command="{Binding DeleteLedgerCommand}"
                            IsEnabled="{Binding SelectedLedger, Converter={StaticResource NullToVis}}" />
                    <Button Content="_Refresh (F5)" Height="{StaticResource ButtonHeightDense}" Padding="10,0"
                            Command="{Binding LoadLedgersCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main DataGrid Area -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
            <DataGrid x:Name="LedgersDataGrid"
                      ItemsSource="{Binding FilteredLedgers}"
                      SelectedItem="{Binding SelectedLedger}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ledger Name" Binding="{Binding Name}" Width="2.2*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Print Name" Binding="{Binding PrintName}" Width="1.8*" />
                    <DataGridTextColumn Header="Account Group" Binding="{Binding GroupName}" Width="1.8*" />
                    <DataGridTextColumn Header="Classification" Binding="{Binding GroupNatureName}" Width="1.2*" />
                    <DataGridTextColumn Header="Opening Balance" Binding="{Binding OpeningBalanceDisplay}" Width="1.4*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NumericValueStyle}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="GSTIN" Binding="{Binding GSTIN}" Width="1.3*" />
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="1.1*" />
                    <DataGridTemplateColumn Header="Type" Width="0.9*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding IsDefaultSystemLedger, Converter={StaticResource SystemBadgeBg}}" Padding="4,0" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding IsDefaultSystemLedger, Converter={StaticResource SystemBadgeText}}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Error Banner -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerStyle}" Margin="0,4,0,0" />

        <!-- Footer / Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="8,4" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="[Alt+A] Add   •   [Alt+M] Modify   •   [Alt+D] Delete   •   [F5] Refresh   •   [Esc] Close"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="_Close (Esc)" MinWidth="80" Height="{StaticResource ButtonHeightDense}" IsCancel="True" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>