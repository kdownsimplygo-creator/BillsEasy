<Window x:Class="BillsEasy.Presentation.Wpf.Views.Masters.AccountGroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="{Binding DialogTitle}"
        Height="380" Width="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        behaviors:KeyboardNavigationBehavior.IsAutoAdvanceEnabled="True"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=GroupNameTextBox}">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="{Binding DialogTitle}"
                                         Subtitle="Configure group hierarchy and financial statement classification nature."
                                         EntityBadge="[Chart of Accounts]" />

        <!-- Form Body -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10">
            <StackPanel>
                <controls:AccountingSection Title="GROUP IDENTIFICATION &amp; HIERARCHY" />
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Group Name -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Group Name *" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="GroupNameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                    <!-- Parent Group Selector -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Parent Group" Style="{StaticResource FormLabelStyle}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="{StaticResource FieldMarginDense}">
                        <ComboBox ItemsSource="{Binding ParentGroupOptions}"
                                  SelectedItem="{Binding SelectedParentGroup}"
                                  DisplayMemberPath="Name" />
                        <TextBlock Text="Select '(Primary Root Group)' to create a top-level group."
                                   Style="{StaticResource HelperTextStyle}" Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Nature Classification -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Group Nature *" Style="{StaticResource FormLabelStyle}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="{StaticResource FieldMarginDense}">
                        <ComboBox ItemsSource="{Binding NatureOptions}"
                                  SelectedItem="{Binding SelectedNature}"
                                  IsEnabled="{Binding IsNatureEnabled}" />
                        <TextBlock Text="Sub-groups automatically inherit parent group classification."
                                   Style="{StaticResource HelperTextStyle}" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- System Group Protection Notice -->
                <Border Visibility="{Binding IsDefaultSystemGroup, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource InfoBackgroundBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="8,4" Margin="0,4,0,0">
                    <TextBlock Text="ℹ Predefined System Group. Core accounting nature is protected." Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource PrimaryBrandBrush}" FontWeight="Medium" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Standard Accounting Footer -->
        <controls:AccountingDialogFooter Grid.Row="2"
                                         ErrorMessage="{Binding ErrorMessage}"
                                         SaveCommand="{Binding SaveCommand}"
                                         SaveButtonText="_Save (F2)"
                                         CancelClicked="Cancel_Click" />
    </Grid>
</Window>