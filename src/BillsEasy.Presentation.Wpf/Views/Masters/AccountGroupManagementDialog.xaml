<Window x:Class="BillsEasy.Presentation.Wpf.Views.Masters.AccountGroupManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dtos="clr-namespace:BillsEasy.Application.DTOs;assembly=BillsEasy.Application"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="Account Group Management — Chart of Accounts"
        Height="590" Width="880"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=GroupsDataGrid}"
        x:Name="ManagementWindow">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadGroupsCommand}" />
        <KeyBinding Gesture="Alt+A" Command="{Binding AddGroupCommand}" CommandParameter="{Binding ElementName=ManagementWindow}" />
        <KeyBinding Gesture="Alt+M" Command="{Binding ModifyGroupCommand}" CommandParameter="{Binding ElementName=ManagementWindow}" />
        <KeyBinding Gesture="Alt+D" Command="{Binding DeleteGroupCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header with Search -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="Account Groups (Chart of Accounts)"
                                         Subtitle="{Binding ActiveCompanyName, StringFormat='Active Company: {0}'}"
                                         EntityBadge="[Master Directory]">
            <controls:AccountingDialogHeader.HeaderRightContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="190" Height="{StaticResource ControlHeightDense}" />
                </StackPanel>
            </controls:AccountingDialogHeader.HeaderRightContent>
        </controls:AccountingDialogHeader>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="6,3" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="_Add Group (Alt+A)" Style="{StaticResource PrimaryButtonStyle}" Height="{StaticResource ButtonHeightDense}" Padding="10,0" Margin="0,0,4,0"
                            Command="{Binding AddGroupCommand}" CommandParameter="{Binding ElementName=ManagementWindow}" />
                    <Button Content="_Modify (Alt+M)" Height="{StaticResource ButtonHeightDense}" Padding="10,0" Margin="0,0,4,0"
                            Command="{Binding ModifyGroupCommand}" CommandParameter="{Binding ElementName=ManagementWindow}"
                            IsEnabled="{Binding SelectedGroup, Converter={StaticResource NullToVis}}" />
                    <Button Content="_Delete (Alt+D)" Style="{StaticResource DangerButtonStyle}" Height="{StaticResource ButtonHeightDense}" Padding="10,0" Margin="0,0,4,0"
                            Command="{Binding DeleteGroupCommand}"
                            IsEnabled="{Binding SelectedGroup, Converter={StaticResource NullToVis}}" />
                    <Button Content="_Refresh (F5)" Height="{StaticResource ButtonHeightDense}" Padding="10,0"
                            Command="{Binding LoadGroupsCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <RadioButton Content="List View" IsChecked="{Binding IsTreeView, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" GroupName="ViewGroup" VerticalAlignment="Center" Margin="0,0,10,0" Click="ListView_Click" />
                    <RadioButton Content="Hierarchy Tree" IsChecked="{Binding IsTreeView}" GroupName="ViewGroup" VerticalAlignment="Center" Click="TreeView_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
            <Grid>
                <!-- Flat DataGrid View -->
                <DataGrid x:Name="GroupsDataGrid"
                          ItemsSource="{Binding FilteredGroups}"
                          SelectedItem="{Binding SelectedGroup}"
                          Visibility="{Binding IsTreeView, Converter={StaticResource InverseBoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Group Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Parent Group" Binding="{Binding ParentGroupName}" Width="2*" />
                        <DataGridTextColumn Header="Classification Nature" Binding="{Binding NatureName}" Width="1.5*" />
                        <DataGridTemplateColumn Header="Type" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding IsDefaultSystemGroup, Converter={StaticResource SystemBadgeBg}}" Padding="4,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding IsDefaultSystemGroup, Converter={StaticResource SystemBadgeText}}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Hierarchical Tree View -->
                <TreeView ItemsSource="{Binding GroupTree}"
                          Background="{StaticResource SurfaceBackgroundBrush}"
                          BorderThickness="0"
                          Visibility="{Binding IsTreeView, Converter={StaticResource BoolToVis}}"
                          x:Name="HierarchyTreeView"
                          SelectedItemChanged="HierarchyTreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type dtos:AccountGroupNodeDto}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding NatureName, StringFormat=' ({0})'}" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0" />
                                <Border Background="{Binding IsDefaultSystemGroup, Converter={StaticResource SystemBadgeBg}}" Padding="4,0" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding IsDefaultSystemGroup, Converter={StaticResource SystemBadgeText}}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- Error Banner -->
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerStyle}" Margin="0,4,0,0" />

        <!-- Footer / Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="8,4" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="[Alt+A] Add   •   [Alt+M] Modify   •   [Alt+D] Delete   •   [F5] Refresh   •   [Esc] Close"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="_Close (Esc)" MinWidth="80" Height="{StaticResource ButtonHeightDense}" IsCancel="True" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>