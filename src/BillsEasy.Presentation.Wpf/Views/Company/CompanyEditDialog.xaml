<Window x:Class="BillsEasy.Presentation.Wpf.Views.Company.CompanyEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="{Binding WindowTitle}"
        Height="540" Width="740"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        behaviors:KeyboardNavigationBehavior.IsAutoAdvanceEnabled="True"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=CompanyNameTextBox}">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="{Binding WindowTitle}"
                                         Subtitle="Configure authoritative company profile, statutory GST, and accounting period bounds."
                                         EntityBadge="[Company Master]" />

        <!-- High-Density Balanced Accounting Form Body -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- SECTION 1: IDENTIFICATION -->
                    <controls:AccountingSection Title="IDENTIFICATION" />
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Company Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Company Name *" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CompanyNameTextBox" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                        <!-- Print Name -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Print Name" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PrintName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                        <!-- Short Name -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Alias / Short Code" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left" Margin="{StaticResource FieldMarginDense}" />
                    </Grid>

                    <!-- SECTION 2: STATUTORY & JURISDICTION -->
                    <controls:AccountingSection Title="STATUTORY &amp; JURISDICTION" />
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="State *" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding States}"
                                  SelectedItem="{Binding SelectedState}"
                                  DisplayMemberPath="StateName" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="State Code" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding SelectedState.StateCode, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}" HorizontalContentAlignment="Center" />
                    </Grid>

                    <!-- SECTION 3: ACCOUNTING PERIOD -->
                    <controls:AccountingSection Title="ACCOUNTING PERIOD" />
                    <Grid Margin="0,2,0,6" IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Financial Year Beg. *" Style="{StaticResource FormLabelStyle}" />
                        <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding FinancialYearBeginning}" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Books Beginning *" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                        <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding BooksBeginningFrom}" />
                    </Grid>

                    <!-- SECTION 4: GST IDENTIFICATION -->
                    <controls:AccountingSection Title="GST &amp; TAXATION" />
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="GSTIN (15 Digits)" Style="{StaticResource FormLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" MaxLength="15" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Registration" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Right" />
                        <ComboBox Grid.Row="0" Grid.Column="4"
                                  ItemsSource="{Binding GstTypes}"
                                  SelectedItem="{Binding SelectedGstType}" />
                    </Grid>

                    <!-- SECTION 5: SECURITY & AUDIT -->
                    <controls:AccountingSection Title="SECURITY &amp; AUDIT" />
                    <CheckBox Content="Enable Security &amp; User Authentication" IsChecked="{Binding IsSecurityEnabled}" Margin="0,2,0,2" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Standard Accounting Footer -->
        <controls:AccountingDialogFooter Grid.Row="2"
                                         ErrorMessage="{Binding ErrorMessage}"
                                         SaveCommand="{Binding SaveCommand}"
                                         SaveButtonText="_Save Company (F2)"
                                         CancelClicked="Cancel_Click" />
    </Grid>
</Window>
