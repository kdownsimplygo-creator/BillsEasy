<Window x:Class="BillsEasy.Presentation.Wpf.Views.Company.CompanyListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="Open / Select Company"
        Height="480" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=CompanyDataGrid}">
    <Window.InputBindings>
        <KeyBinding Gesture="Alt+D" Command="{Binding DeleteSelectedCompanyCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="Open / Select Company"
                                         Subtitle="Select a business profile from the directory to load its chart of accounts and books."
                                         EntityBadge="[Directory]" />

        <!-- Companies DataGrid -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
            <DataGrid x:Name="CompanyDataGrid"
                      ItemsSource="{Binding Companies}"
                      SelectedItem="{Binding SelectedCompany}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}" Width="2.2*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="State / Jurisdiction" Binding="{Binding StateName}" Width="1.2*" />
                    <DataGridTextColumn Header="GSTIN" Binding="{Binding GSTIN}" Width="1.4*" />
                    <DataGridTextColumn Header="FY Beginning" Binding="{Binding FinancialYearBeginning}" Width="1.1*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status / Validation -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource ErrorBannerStyle}" Margin="0,4,0,0" />

        <!-- Standard Footer & Shortcut Bar -->
        <Border Grid.Row="3" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="8,4" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="[Enter] Open   •   [Alt+D] Delete   •   [Esc] Close"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="_Open Company (Enter)" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Height="{StaticResource ButtonHeightDense}" Margin="0,0,6,0" IsDefault="True" Command="{Binding OpenSelectedCompanyCommand}" />
                    <Button Content="_Delete (Alt+D)" Style="{StaticResource DangerButtonStyle}" MinWidth="100" Height="{StaticResource ButtonHeightDense}" Margin="0,0,6,0" Command="{Binding DeleteSelectedCompanyCommand}" />
                    <Button Content="_Close (Esc)" MinWidth="80" Height="{StaticResource ButtonHeightDense}" IsCancel="True" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
