<Window x:Class="BillsEasy.Presentation.Wpf.Views.Company.FinancialYearManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="Financial Year Management"
        Height="490" Width="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=FinancialYearsDataGrid}">
    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="Financial Year Management"
                                         Subtitle="{Binding CompanyTitle, StringFormat='Active Company: {0}'}"
                                         EntityBadge="[Period Master]" />

        <!-- Financial Years DataGrid -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1">
            <DataGrid x:Name="FinancialYearsDataGrid"
                      ItemsSource="{Binding FinancialYears}"
                      SelectedItem="{Binding SelectedFinancialYear}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Year Name" Binding="{Binding YearName}" Width="1.5*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate}" Width="*" />
                    <DataGridTextColumn Header="End Date" Binding="{Binding EndDate}" Width="*" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="0.7*" />
                    <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLocked}" Width="0.7*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Create New FY Panel -->
        <StackPanel Grid.Row="2" Margin="0,6,0,0">
            <controls:AccountingSection Title="CREATE NEXT FINANCIAL YEAR" />
            <Border Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="10,6"
                    behaviors:KeyboardNavigationBehavior.IsAutoAdvanceEnabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date *" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,2" />
                        <DatePicker SelectedDate="{Binding NewStartDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End Date *" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,2" />
                        <DatePicker SelectedDate="{Binding NewEndDate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Year Name *" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding NewYearName}" />
                    </StackPanel>

                    <Button Grid.Column="6" Content="Create FY" Style="{StaticResource PrimaryButtonStyle}" MinWidth="90" Height="{StaticResource ButtonHeightDense}" VerticalAlignment="Bottom" Command="{Binding CreateYearCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Status Message -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,4,0,0" />

        <!-- Footer Action & Shortcut Strip -->
        <Border Grid.Row="4" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="8,4" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="[Enter] Edit / Select   •   [Esc] Close"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="_Set as Active Year" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" Height="{StaticResource ButtonHeightDense}" Margin="0,0,6,0" Command="{Binding SetActiveYearCommand}" />
                    <Button Content="_Close (Esc)" MinWidth="80" Height="{StaticResource ButtonHeightDense}" IsCancel="True" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
