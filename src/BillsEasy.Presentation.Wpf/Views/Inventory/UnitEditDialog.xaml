<Window x:Class="BillsEasy.Presentation.Wpf.Views.Inventory.UnitEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="{Binding DialogTitle}"
        Height="360" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        ResizeMode="NoResize"
        behaviors:KeyboardNavigationBehavior.IsAutoAdvanceEnabled="True"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=UnitNameTextBox}">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="{Binding DialogTitle}"
                                         Subtitle="Configure measurement unit name and display precision."
                                         EntityBadge="[Inventory]" />

        <!-- Form Body -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10">
            <StackPanel>
                <controls:AccountingSection Title="UNIT PROPERTIES" />
                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FormLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Unit Name -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Unit Name *" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="UnitNameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                    <!-- Print Name -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Print Name" Style="{StaticResource FormLabelStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PrintName, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                    <!-- Decimal Places -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Decimal Places (0-4)" Style="{StaticResource FormLabelStyle}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="{StaticResource FieldMarginDense}">
                        <TextBox Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                        <TextBlock Text="0 for discrete units (Pcs, Nos), 2 or 3 for weight/length (Kg, Mtr)."
                                   Style="{StaticResource HelperTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Error Message -->
                <Border Background="{StaticResource ErrorBackgroundBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1"
                        Padding="8,4" Margin="0,4,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorForegroundBrush}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Standard Footer -->
        <controls:AccountingDialogFooter Grid.Row="2"
                                         SaveCommand="{Binding SaveCommand}"
                                         Margin="0,8,0,0" />
    </Grid>
</Window>
