<Window x:Class="BillsEasy.Presentation.Wpf.Views.Inventory.ItemGroupManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        xmlns:behaviors="clr-namespace:BillsEasy.Presentation.Wpf.Behaviors"
        Title="Item Groups Master — Inventory Organization"
        Height="550" Width="850"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        behaviors:KeyboardNavigationBehavior.InitialFocusElement="{Binding ElementName=GroupsDataGrid}"
        x:Name="ManagementWindow">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding LoadGroupsCommand}" />
        <KeyBinding Gesture="Alt+A" Command="{Binding AddGroupCommand}" CommandParameter="{Binding ElementName=ManagementWindow}" />
        <KeyBinding Gesture="Alt+M" Command="{Binding ModifyGroupCommand}" CommandParameter="{Binding ElementName=ManagementWindow}" />
        <KeyBinding Gesture="Alt+D" Command="{Binding DeleteGroupCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header with Search -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="Item Groups Master"
                                         Subtitle="{Binding ActiveCompanyName, StringFormat='Active Company: {0}'}"
                                         EntityBadge="[Inventory Hierarchy]">
            <controls:AccountingDialogHeader.HeaderRightContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="{StaticResource ControlHeightDense}" />
                </StackPanel>
            </controls:AccountingDialogHeader.HeaderRightContent>
        </controls:AccountingDialogHeader>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="6,3" Margin="0,0,0,6">
            <DockPanel LastChildFill="False">
                <Button Content="Add Group (Alt+A)" Command="{Binding AddGroupCommand}" CommandParameter="{Binding ElementName=ManagementWindow}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Modify (Alt+M)" Command="{Binding ModifyGroupCommand}" CommandParameter="{Binding ElementName=ManagementWindow}"
                        IsEnabled="{Binding SelectedGroup, Converter={StaticResource NullToBoolConverter}}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Delete (Alt+D)" Command="{Binding DeleteGroupCommand}"
                        IsEnabled="{Binding SelectedGroup, Converter={StaticResource NullToBoolConverter}}"
                        Style="{StaticResource DangerButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Refresh (F5)" Command="{Binding LoadGroupsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <!-- Data Grid -->
        <DataGrid Grid.Row="2"
                  x:Name="GroupsDataGrid"
                  ItemsSource="{Binding FilteredGroups}"
                  SelectedItem="{Binding SelectedGroup}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group Name" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="Parent Group" Binding="{Binding ParentGroupName}" Width="200" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd'}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Error Message Notification Strip -->
        <Border Grid.Row="3" Background="{StaticResource ErrorBackgroundBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1"
                Padding="8,4" Margin="0,6,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorForegroundBrush}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" />
        </Border>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource ShortcutBarBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="8,4" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="[Alt+A] Add   •   [Alt+M] Modify   •   [Alt+D] Delete   •   [F5] Refresh   •   [Esc] Close"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="_Close (Esc)" MinWidth="80" Height="{StaticResource ButtonHeightDense}" IsCancel="True" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
