<Window x:Class="BillsEasy.Presentation.Wpf.Views.Purchase.PurchaseInvoiceEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BillsEasy.Presentation.Wpf.Controls"
        x:Name="PurchaseDialog"
        Title="{Binding DialogTitle}"
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding SaveCommand}" CommandParameter="{Binding ElementName=PurchaseDialog}" />
        <KeyBinding Key="F3" Command="{Binding QuickCreateSupplierCommand}" CommandParameter="{Binding ElementName=PurchaseDialog}" />
        <KeyBinding Key="F9" Command="{Binding RemoveItemLineCommand}" />
    </Window.InputBindings>

    <Grid Margin="{StaticResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Standard Accounting Header -->
        <controls:AccountingDialogHeader Grid.Row="0"
                                         Title="{Binding DialogTitle}"
                                         Subtitle="Commercial Purchase Invoice with integrated financial voucher, stock inward, and bill-wise tracking."
                                         EntityBadge="[Purchase / Inward]" />

        <!-- Header Information Strip -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="14,10" Margin="0,4,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Series, Date, Vch No. -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Series" Style="{StaticResource FormLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Series, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />

                <TextBlock Grid.Row="0" Grid.Column="3" Text="Date *" Style="{StaticResource FormLabelStyle}" />
                <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding InvoiceDate}" Margin="{StaticResource FieldMarginDense}" />

                <TextBlock Grid.Row="0" Grid.Column="6" Text="Vch No. *" Style="{StaticResource FormLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="7" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" FontWeight="Bold" />

                <!-- Row 1: Party (Supplier) + Balance, Mat. Centre -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Party *" Style="{StaticResource FormLabelStyle}" Margin="0,6,0,0" />
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="{StaticResource FieldMarginDense}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding SupplierOptions}"
                              SelectedItem="{Binding SelectedSupplier}"
                              DisplayMemberPath="Name"
                              IsEditable="True" />
                    <Button Grid.Column="1" Content="F3 Add" Margin="4,0,0,0" Padding="8,2"
                            Command="{Binding QuickCreateSupplierCommand}"
                            CommandParameter="{Binding ElementName=PurchaseDialog}"
                            ToolTip="Create New Supplier on the Fly (F3)" />
                    <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding SupplierLiveBalanceText}" FontWeight="Bold" Foreground="#1E40AF" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="6" Text="Mat. Centre" Style="{StaticResource FormLabelStyle}" Margin="0,6,0,0" />
                <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding MaterialCentre, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />
            </Grid>
        </Border>

        <!-- Dual Grid Body (Items Upper, Sundries Lower) -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Upper Grid: Items -->
            <GroupBox Grid.Row="0" Header="Item Details (Stock Products)" Margin="0,0,0,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding ItemLines}"
                              SelectedItem="{Binding SelectedLine}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              BorderThickness="1"
                              BorderBrush="{StaticResource BorderMediumBrush}"
                              GotFocus="DataGrid_GotFocus"
                              PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="40" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Item Name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding SelectedItem.Name}" VerticalAlignment="Center" Margin="6,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="(Select Item — Type or press Down)" VerticalAlignment="Center" Margin="6,0"
                                                       Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                       Visibility="{Binding SelectedItem, Converter={StaticResource InverseNullToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"
                                                  MaxDropDownHeight="240"
                                                  Loaded="ComboBox_Loaded"
                                                  PreviewKeyDown="ComboBox_PreviewKeyDown"
                                                  Padding="4,2" VerticalContentAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,2" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrandBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Price (₹)" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="4,2" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, StringFormat=N2}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="+ Add Item" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddItemLineCommand}" Margin="0,0,8,0" Padding="8,2" />
                        <Button Content="- Delete Item (F9)" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoveItemLineCommand}" Padding="8,2" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Splitter / Divider -->
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#E2E8F0" Margin="0,2" />

            <!-- Lower Grid: Bill Sundries -->
            <GroupBox Grid.Row="2" Header="Bill Sundries (Freight &amp; Forwarding Charges, etc.)" Margin="0,4,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding SundryLines}"
                              SelectedItem="{Binding SelectedSundry}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              BorderThickness="1"
                              BorderBrush="{StaticResource BorderMediumBrush}"
                              GotFocus="DataGrid_GotFocus"
                              PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="40" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Bill Sundry / Ledger" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding SelectedLedger.Name}" VerticalAlignment="Center" Margin="6,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="(Select Bill Sundry)" VerticalAlignment="Center" Margin="6,0"
                                                       Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic"
                                                       Visibility="{Binding SelectedLedger, Converter={StaticResource InverseNullToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableSundryLedgers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedLedger, UpdateSourceTrigger=PropertyChanged}"
                                                  Text="{Binding LedgerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"
                                                  MaxDropDownHeight="240"
                                                  Loaded="ComboBox_Loaded"
                                                  PreviewKeyDown="ComboBox_PreviewKeyDown"
                                                  Padding="4,2" VerticalContentAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Percentage (%)" Binding="{Binding Percentage, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                            <DataGridTextColumn Header="Amount (₹)" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Margin" Value="0,0,6,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="+ Add Sundry" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddSundryLineCommand}" Margin="0,0,8,0" Padding="8,2" />
                        <Button Content="- Delete Sundry" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoveSundryLineCommand}" Padding="8,2" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Narration & Totals Strip -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBackgroundBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Padding="12,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Narration: " Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBox Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource FieldMarginDense}" />
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Item Subtotal" FontSize="{StaticResource FontSizeSmall}" Foreground="#64748B" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ItemSubtotal, StringFormat=₹{0:N2}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Bill Sundry" FontSize="{StaticResource FontSizeSmall}" Foreground="#64748B" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding SundrySubtotal, StringFormat=₹{0:N2}}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeMedium}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,4" CornerRadius="2">
                        <StackPanel>
                            <TextBlock Text="GRAND TOTAL" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding GrandTotal, StringFormat=₹{0:N2}}" FontWeight="Bold" FontSize="18" Foreground="#0F172A" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error Message Strip -->
        <Border Grid.Row="4"
                Background="{StaticResource ErrorBackgroundBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1"
                Padding="8,4" Margin="0,6,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorForegroundBrush}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" />
        </Border>

        <!-- Standard Footer -->
        <controls:AccountingDialogFooter Grid.Row="5"
                                         SaveCommand="{Binding SaveCommand}"
                                         Margin="0,8,0,0" />
    </Grid>
</Window>
