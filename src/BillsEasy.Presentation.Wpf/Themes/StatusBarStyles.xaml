<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="Background" Value="{StaticResource StatusBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderMediumBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource StatusBarTextBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style TargetType="{x:Type StatusBarItem}">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
