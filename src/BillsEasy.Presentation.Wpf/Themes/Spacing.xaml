<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing Dimension Tokens -->
    <sys:Double x:Key="SpacingXS">2</sys:Double>
    <sys:Double x:Key="SpacingSM">4</sys:Double>
    <sys:Double x:Key="SpacingMD">6</sys:Double>
    <sys:Double x:Key="SpacingLG">10</sys:Double>
    <sys:Double x:Key="SpacingXL">14</sys:Double>
    <sys:Double x:Key="Spacing2XL">20</sys:Double>

    <!-- Standard Accounting Control Dimensions (Crisp & High-Density) -->
    <sys:Double x:Key="ControlHeightDense">24</sys:Double>
    <sys:Double x:Key="ControlHeightStandard">26</sys:Double>
    <sys:Double x:Key="ControlHeightComfortable">28</sys:Double>

    <!-- Button Height Tokens -->
    <sys:Double x:Key="ButtonHeightDense">24</sys:Double>
    <sys:Double x:Key="ButtonHeightStandard">26</sys:Double>
    <sys:Double x:Key="ButtonHeightComfortable">28</sys:Double>

    <!-- DataGrid Dimensions -->
    <sys:Double x:Key="DataGridRowHeightDense">22</sys:Double>
    <sys:Double x:Key="DataGridRowHeightStandard">24</sys:Double>
    <sys:Double x:Key="DataGridHeaderHeightDense">24</sys:Double>

    <!-- Standard Form Label Widths -->
    <GridLength x:Key="FormLabelWidth">160</GridLength>
    <GridLength x:Key="FormLabelWidthShort">120</GridLength>

    <!-- Corner Radius Tokens (Sharp Native Desktop Standard) -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">1</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">2</CornerRadius>

    <!-- Semantic Thickness / Margin Tokens -->
    <Thickness x:Key="FieldMarginDense">0,1,0,3</Thickness>
    <Thickness x:Key="LabelMarginDense">0,0,8,0</Thickness>
    <Thickness x:Key="DialogPadding">12,10,12,10</Thickness>
    <Thickness x:Key="CardPadding">10,8,10,8</Thickness>
    <Thickness x:Key="GridCellPadding">6,1</Thickness>
    <Thickness x:Key="GridHeaderPadding">6,3</Thickness>

</ResourceDictionary>
